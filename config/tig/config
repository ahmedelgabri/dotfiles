# tig configuration — see `man tigrc` for the full reference.

# Views
# -----
# Column types and their options are documented under "View settings" in
# `man tigrc`.

set blame-view  = date:default author:full file-name:auto id:yes,color line-number:no,interval=1 text
set grep-view   = file-name:no line-number:yes,interval=1 text
set main-view   = line-number:no,interval=1 id:no date:default author:full commit-title:yes,graph,refs,overflow=no
set refs-view   = line-number:no id:no date:default author:full ref commit-title
set stash-view  = line-number:no,interval=1 id:no date:default author:full commit-title
set status-view = line-number:no,interval=1 status:short file-name
set tree-view   = line-number:no,interval=1 mode author:full file-size date:default id:no file-name

# Pager based views
set pager-view  = line-number:no,interval=1 text
set stage-view  = line-number:no,interval=1 text
set log-view    = line-number:no,interval=1 text
set blob-view   = line-number:no,interval=1 text
set diff-view   = line-number:no,interval=1 text:yes,commit-title-overflow=no

# UI
# --
set show-changes          = yes    # Show changes commits in the main view?
set wrap-lines            = no     # Wrap long lines in pager views?
set tab-size              = 8      # Number of spaces to use when expanding tabs
set line-graphics         = utf-8  # Enum: ascii, default, utf-8
set truncation-delimiter  = utf-8  # Draw truncations with an ellipsis
set main-view-id          = true
set focus-child           = yes    # Move focus to child view when opened?
set horizontal-scroll     = 50%    # Number of columns to scroll as % of width
set split-view-height     = 67%    # Height of the bottom view for horizontal splits
set vertical-split        = auto   # Horizontal split unless width allows vertical
set split-view-width      = 50%    # Width of right-most view for vertical splits
set mouse                 = yes
set mouse-scroll          = 3      # Number of lines to scroll via the mouse
set mouse-wheel-cursor    = no     # Prefer moving the cursor to scrolling the view?

# Reference display: [branch] <tag> {remote} ~replace~. `hide:other`
# drops non-branch/tag refs such as the bookkeeping refs jj and
# git-branchless create (refs/jj/*), which otherwise flood the views in
# colocated repos.
set reference-format      = [branch] <tag> {remote} ~replace~ hide:other

# Git interop
# -----------
set commit-order                = auto        # Chronological unless topo order is needed
set status-show-untracked-dirs  = yes
set status-show-untracked-files = yes
set ignore-space                = no
set show-notes                  = yes
set mailmap                     = yes         # Canonical names/emails via .mailmap
set blame-options               = -w -C -C -C # Keep in sync with `git config alias.blame`

# Misc
# ----
# jj rewrites refs and the working copy often in colocated repos; auto
# refresh keeps the views current without manual reloads.
set refresh-mode          = auto
set refresh-interval      = 1
set ignore-case           = smart-case
set wrap-search           = yes
set editor-line-number    = yes    # Open the editor at the selected line
set history-size          = 1000
set start-on-head         = yes    # Colocated repos usually have a detached HEAD at jj's @-;
                                   # start there instead of on the newest ref

# Bindings
# --------
# `%(...)` state variables and command flags (!, @, ?, <) are documented
# under "User-defined commands" in `man tigrc`.
bind   generic    g             none            # Clear old 'g' binding to allow for 'gg' etc.
bind   generic    gg            move-first-line
bind   main       G             none            # Clear commit graph toggling
bind   generic    G             move-last-line
bind   stash D !?git stash drop %(stash)
bind   stash A !?git stash apply %(stash)
bind   status S !?git stash save --keep-index %(prompt)

# Colors
# ------
# Custom pager/diff matches can be added by quoting the text to match,
# e.g. color "    Signed-off-by" yellow default (note git's four-space
# commit message indent).

# general
# Match the plain conventions used by jj/eza/aerc across all views:
# selection on the slot-0 bar, ids blue, authors cyan, dates dim, refs
# magenta (like jj bookmarks and git log decorations), chrome gray, and
# red/green/yellow reserved for states.
color  cursor                  default  black
# Unfocused views keep their own cursor area (LINE_CURSOR_BLUR, absent
# from the tigrc man page); without this it stays tig's white-on-green.
color  cursor-blur             default  black
color  title-focus             default  default  reverse
color  title-blur              default  black
color  id                      blue     default
color  author                  cyan     default
color  date                    default  default  dim
color  line-number             8        default
color  delimiter               8        default
color  mode                    8        default
color  file-size               default  default  dim
color  header                  8        default
color  directory               blue     default
color  status                  default  default
color  search-result           0        yellow

# Main view ref types not covered by the git-colors mapping below.
color  main-tag                magenta  default
color  main-local-tag          magenta  default
color  main-ref                magenta  default
color  main-tracked            green    default

# Diff and log views. Added/deleted lines match bat's plain diff colors
# (flat green/red, without the strike/italic that git's color.diff uses),
# so their git-colors mappings are removed below; word-level changes get
# reverse video like jj's diff tokens. Chunk and meta lines still come
# from the git mapping.
color  diff-add                green    default
color  diff-del                red      default
color  diff-add-highlight      green    default  reverse
color  diff-del-highlight      red      default  reverse
color  commit                  blue     default
color  "Author: "              cyan     default
color  "Commit: "              blue     default
color  "Date: "                default  default  dim
color  "Refs: "                magenta  default

# Status view (file states come from the git mapping).
color  status.header           default  default  bold

# Grep view.
color  grep.file               blue     default
color  grep.line-number        8        default
color  grep.delimiter          8        default

# Commit graph lines: accent cycle without red/yellow, then bold variants.
color  palette-0               blue     default
color  palette-1               magenta  default
color  palette-2               cyan     default
color  palette-3               green    default
color  palette-4               8        default
color  palette-5               default  default
color  palette-6               white    default
color  palette-7               blue     default  bold
color  palette-8               magenta  default  bold
color  palette-9               cyan     default  bold
color  palette-10              green    default  bold
color  palette-11              8        default  bold
color  palette-12              default  default  bold
color  palette-13              white    default  bold

# Mappings for colors read from git configuration.
# Set to "no" to disable.
set git-colors = \
  branch.current=main-head \
  branch.local=main-ref \
  branch.plain=main-ref \
  branch.remote=main-remote \
  \
  diff.meta=diff-header \
  diff.meta=diff-index \
  diff.meta=diff-oldmode \
  diff.meta=diff-newmode \
  diff.frag=diff-chunk \
  \
  grep.filename=grep.file \
  grep.linenumber=grep.line-number \
  grep.separator=grep.delimiter \
  \
  status.branch=status.header \
  status.added=stat-staged \
  status.updated=stat-staged \
  status.changed=stat-unstaged \
  status.untracked=stat-untracked
