#!/usr/bin/env bash

# mx
# version 1.1

# Contributors:
#   Wynn Netherland - http://github.com/pengwynn
#   Adam Jahnke - http://github.com/adamyonk
#   Yoshua Wuyts - https://github.com/yoshuawuyts
#   Ahmed El Gabri - https://github.com/ahmedelgabri

# Usage:
#   mx [session] [subdirectory (optional)]
#   mx --list           print session/project candidates as TSV

# To 'auto-launch' projects, you'll need a $PROJECTS dir where you keep code
# sorted like so: $PROJECTS/<org or user>/<repo>.
# So, a typical workflow would look like:
#   $ hub clone pengwynn/octonaut $PROJECTS/pengwynn/octonaut
#   $ mx octonaut

# If `mx` is called with a <session> name, and there is no valid repo inside
# $PROJECTS, a new tmux session will be initialized in the current working
# directory with a name of <session>

set -ue -o pipefail

if [[ -n "${DEBUG-}" ]]; then
	set -x
fi

MX_START=${MX_START:-"./.mx-start"}

get_session() {
	echo "$1" | awk -F"/" '{print $NF}'
}

# mx --list enumerates session candidates as TSV: <kind>\t<label>\t<abspath>
#   kind    = 'sess' (session definition file) or 'dir' (project directory)
#   label   = definition name, or dir path relative to $PROJECTS
#   abspath = the definition file for 'sess', the directory for 'dir'
#
# Root rules:
#   personal|trunk|forks|ahmedelgabri : every direct subdirectory
#   work/<org>/<project>              : every project; .bare projects also
#                                       list child worktrees (subdirs with .git)
#   archive                           : project children are leaves; other
#                                       children are grouping dirs whose child
#                                       dirs are candidates
#
# Deliberately uses shell globs instead of fd: a bare fd honors the global
# ignore file (config/.ignore) and would silently hide candidates, and fd -I
# would cost an external process per depth-1 listing for no gain over the
# builtin. nullglob makes missing roots and empty dirs a no-op, and plain */
# globs skip files and dotdirs.

shopt -s nullglob

# Session definition search path; first hit wins
SESSION_DIRS=(
	"${HOST_CONFIGS:+$HOST_CONFIGS/tmux/sessions}"
	"${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions"
)

emit() {
	printf '%s\t%s\t%s\n' "$1" "$2" "$3"
}

# A git repo, a git-wt bare layout, or a (possibly non-colocated) jj repo.
is_project() {
	[ -e "$1/.git" ] || [ -e "$1/.bare" ] || [ -e "$1/.jj" ]
}

# In a .bare layout only children holding a .git entry are worktrees; the
# filter keeps scratch dirs (e.g. work/miro/c/_) out of the candidate list.
emit_worktrees() {
	local proj="$1" label="$2" wt
	for wt in "$proj"/*/; do
		wt="${wt%/}"
		[ -e "$wt/.git" ] || continue
		emit dir "$label/$(basename "$wt")" "$wt"
	done
}

list_sessions() {
	local dir f name
	local -A seen=()
	# $HOST_CONFIGS wins over the repo-tracked dir
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] && [ -d "$dir" ] || continue
		for f in "$dir"/*; do
			[ -f "$f" ] || continue
			name="$(basename "$f")"
			[ -n "${seen[$name]-}" ] && continue
			seen[$name]=1
			emit sess "$name" "$f"
		done
	done
}

list_flat() {
	local d
	for d in "$PROJECTS/$1"/*/; do
		d="${d%/}"
		emit dir "$1/$(basename "$d")" "$d"
	done
}

list_work() {
	local org proj label
	for org in "$PROJECTS/work"/*/; do
		org="${org%/}"
		for proj in "$org"/*/; do
			proj="${proj%/}"
			label="work/$(basename "$org")/$(basename "$proj")"
			emit dir "$label" "$proj"
			if [ -e "$proj/.bare" ]; then
				emit_worktrees "$proj" "$label"
			fi
		done
	done
}

list_archive() {
	local d label sub
	for d in "$PROJECTS/archive"/*/; do
		d="${d%/}"
		label="archive/$(basename "$d")"
		if is_project "$d"; then
			emit dir "$label" "$d"
			if [ -e "$d/.bare" ]; then
				emit_worktrees "$d" "$label"
			fi
		else
			for sub in "$d"/*/; do
				sub="${sub%/}"
				emit dir "$label/$(basename "$sub")" "$sub"
			done
		fi
	done
}

list_candidates() {
	: "${PROJECTS:?PROJECTS is not set}"
	list_sessions
	list_work
	list_flat trunk
	list_flat personal
	list_flat forks
	list_flat ahmedelgabri
	list_archive
}

if [ "${1-}" = "--list" ]; then
	list_candidates
	exit 0
fi

SESSION="$(get_session "${1:-$(pwd)}")"
# tmux 1.9a+ doesn't like .'s in session names
TMUX_SESSION_NAME="${SESSION//./_}"

if ! (tmux has-session -t "$SESSION" &>/dev/null); then
	mx-init

	WORKINGDIR=""

	if [ -d "$WORK/$SESSION/${2-}" ]; then
		WORKINGDIR="$WORK/$SESSION/$2"
	elif [ -d "$WORK/$SESSION" ]; then
		WORKINGDIR="$WORK/$SESSION"
	elif [ -d "$PROJECTS/$SESSION" ]; then
		WORKINGDIR="$PROJECTS/$SESSION"
	else
		WORKINGDIR="$PWD"
	fi

	if [ -n "$WORKINGDIR" ]; then
		cd "$WORKINGDIR"
		tmux new-session -d -s "$TMUX_SESSION_NAME"
		tmux select-window -t "$TMUX_SESSION_NAME"
		# Sometimes I need to setup some project specific stuff & run some commands
		if [ -x "$MX_START" ]; then
			tmux send-keys "$MX_START" C-m
		fi
	fi

	if tmux has-session -t _shared:mail 2>/dev/null; then
		tmux link-window -s _shared:mail -t 6
	fi

	if tmux has-session -t _shared:rss 2>/dev/null; then
		tmux link-window -s _shared:rss -t 7
	fi

	if tmux has-session -t _shared:HN 2>/dev/null; then
		tmux link-window -s _shared:HN -t 8
	fi

	if tmux has-session -t _shared:dotfiles 2>/dev/null; then
		tmux link-window -s _shared:dotfiles -t 9
	fi

	if tmux has-session -t _shared:notes 2>/dev/null; then
		tmux link-window -s _shared:notes -t 10
	fi

	tmux select-window -t 1
fi

if [ -z "${TMUX-}" ]; then
	tmux attach -t "$TMUX_SESSION_NAME"
else
	tmux switch-client -t "$TMUX_SESSION_NAME"
fi
