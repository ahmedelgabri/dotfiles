#!/usr/bin/env bash

# mx
# version 2.1

# Contributors:
#   Wynn Netherland - http://github.com/pengwynn
#   Adam Jahnke - http://github.com/adamyonk
#   Yoshua Wuyts - https://github.com/yoshuawuyts
#   Ahmed El Gabri - https://github.com/ahmedelgabri

# Usage:
#   mx                  session for $PWD (name = basename of $PWD)
#   mx <name>           session definition lookup, then project lookup by name
#   mx --dir <path>     plain session rooted exactly at <path>
#   mx --list           print session/project candidates as TSV
#   mx --pick [query]   fuzzy-pick a candidate and launch it
#   mx --export [session]
#                       print a definition based on a tmux session
#   mx -h|--help        print usage
#
# Session definitions are plain bash files sourced by mx, looked up as
# $HOST_CONFIGS/tmux/sessions/<name> then $XDG_CONFIG_HOME/tmux/sessions/<name>.
# A definition may set MX_ROOT=<dir> and define mx_start(); mx creates the
# detached session at MX_ROOT, exports MX_SESSION and MX_ROOT, then calls
# mx_start synchronously. Inside mx_start every tmux command must target
# "=$MX_SESSION" explicitly: when mx runs from inside tmux, unqualified
# targets resolve against the caller's session, not the new one. mx_start
# runs with errexit suppressed, so a failing command inside it does not
# abort the layout or strand the session unattached.
#
# Project lookup resolves <name> against --list labels (exact match, or a
# unique /<name> suffix), so `mx git-wt` and `mx c/master` work from
# anywhere. No match falls back to a plain session at $PWD.

set -ue -o pipefail

if [[ -n "${DEBUG-}" ]]; then
	set -x
fi

usage_text() {
	echo "Usage: mx [<name>] | mx --dir <path> | mx --list | mx --pick [query] | mx --export [session]"
}

usage() {
	usage_text >&2
	exit 64
}

show_help() {
	usage_text
	exit 0
}

sanitize() {
	# tmux forbids '.' and ':' in session names
	local s="${1//./_}"
	printf '%s\n' "${s//:/_}"
}

# Session definition search path; first hit wins
SESSION_DIRS=(
	"${HOST_CONFIGS:+$HOST_CONFIGS/tmux/sessions}"
	"${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions"
)

find_session_file() {
	local dir f
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] || continue
		f="$dir/$1"
		if [ -f "$f" ]; then
			printf '%s\n' "$f"
			return 0
		fi
	done
	return 1
}

# mx --list enumerates session candidates as TSV: <kind>\t<label>\t<abspath>
#   kind    = 'sess' (session definition file) or 'dir' (project directory)
#   label   = definition name, or dir path relative to $PROJECTS
#   abspath = the definition file for 'sess', the directory for 'dir'
#
# Root rules:
#   personal|trunk|forks|ahmedelgabri : every direct subdirectory
#   work/<org>/<project>              : every project; .bare projects also
#                                       list child worktrees (subdirs with .git)
#   archive                           : project children are leaves; other
#                                       children are grouping dirs whose child
#                                       dirs are candidates
#
# Deliberately uses shell globs instead of fd: a bare fd honors the global
# ignore file (config/.ignore) and would silently hide candidates, and fd -I
# would cost an external process per depth-1 listing for no gain over the
# builtin. nullglob makes missing roots and empty dirs a no-op, and plain */
# globs skip files and dotdirs.

shopt -s nullglob

emit() {
	printf '%s\t%s\t%s\n' "$1" "$2" "$3"
}

# A git repo, a git-wt bare layout, or a (possibly non-colocated) jj repo.
is_project() {
	[ -e "$1/.git" ] || [ -e "$1/.bare" ] || [ -e "$1/.jj" ]
}

# In a .bare layout only children holding a .git entry are worktrees; the
# filter keeps scratch dirs (e.g. work/<name>/c/_) out of the candidate list.
emit_worktrees() {
	local proj="$1" label="$2" wt
	for wt in "$proj"/*/; do
		wt="${wt%/}"
		[ -e "$wt/.git" ] || continue
		emit dir "$label/${wt##*/}" "$wt"
	done
}

list_sessions() {
	local dir f name
	local -A seen=()
	# $HOST_CONFIGS wins over the repo-tracked dir
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] && [ -d "$dir" ] || continue
		for f in "$dir"/*; do
			[ -f "$f" ] || continue
			name="${f##*/}"
			[ -n "${seen[$name]-}" ] && continue
			seen[$name]=1
			emit sess "$name" "$f"
		done
	done
}

list_flat() {
	local d
	for d in "$PROJECTS/$1"/*/; do
		d="${d%/}"
		emit dir "$1/${d##*/}" "$d"
	done
}

list_work() {
	local org org_name proj label
	for org in "$PROJECTS/work"/*/; do
		org="${org%/}"
		org_name="${org##*/}"
		for proj in "$org"/*/; do
			proj="${proj%/}"
			label="work/$org_name/${proj##*/}"
			emit dir "$label" "$proj"
			if [ -e "$proj/.bare" ]; then
				emit_worktrees "$proj" "$label"
			fi
		done
	done
}

list_archive() {
	local d label sub
	for d in "$PROJECTS/archive"/*/; do
		d="${d%/}"
		label="archive/${d##*/}"
		if is_project "$d"; then
			emit dir "$label" "$d"
			if [ -e "$d/.bare" ]; then
				emit_worktrees "$d" "$label"
			fi
		else
			for sub in "$d"/*/; do
				sub="${sub%/}"
				emit dir "$label/${sub##*/}" "$sub"
			done
		fi
	done
}

list_candidates() {
	: "${PROJECTS:?PROJECTS is not set}"
	list_sessions
	list_work
	list_flat trunk
	list_flat personal
	list_flat forks
	list_flat ahmedelgabri
	list_archive
}

resolve_dirs() {
	# all --list dir candidates whose label is $1 or ends in /$1
	list_candidates | awk -F'\t' -v n="$1" \
		'$1 == "dir" && ($2 == n || substr($2, length($2) - length(n)) == "/" n) { print $3 }'
}

derive_name() {
	local rel="${1#"${PROJECTS-}"/}"
	case "$rel" in
	work/*/*) rel="${rel#work/*/}" ;; # <project> or <project>/<worktree>
	forks/* | archive/*) ;;           # duplication is structural; keep qualified
	*) rel="${rel##*/}" ;;            # canonical homes: basename only
	esac
	printf '%s\n' "$rel"
}

link_shared_windows() {
	local name="$1" index window

	index="$(tmux list-windows -t "=$name" -F '#{window_index}' | tail -n 1)"
	for window in mail rss HN dotfiles notes; do
		if tmux has-session -t "=_shared:$window" 2>/dev/null; then
			index=$((index + 1))
			tmux link-window -s "=_shared:$window" -t "=$name:$index"
		fi
	done
}

# These helpers print shell code containing variables for the exported file.
# shellcheck disable=SC2016
export_root_expr() {
	local path="$1" suffix
	if [[ "$path" == "$HOME" ]]; then
		printf '"$HOME"'
	elif [[ "$path" == "$HOME/"* ]]; then
		suffix="${path#"$HOME"/}"
		printf '"$HOME"/%q' "$suffix"
	else
		printf '%q' "$path"
	fi
}

# shellcheck disable=SC2016
export_dir_expr() {
	local path="$1" root="$2" suffix
	if [[ "$path" == "$root" ]]; then
		printf '"$MX_ROOT"'
	elif [[ "$path" == "$root/"* ]]; then
		suffix="${path#"$root"/}"
		printf '"$MX_ROOT"/%q' "$suffix"
	else
		export_root_expr "$path"
	fi
}

# Print a definition based on an existing session. Linked windows are omitted
# because mx adds _shared after mx_start. Tmux can report the current process
# name but not its original arguments, so commands are comments for review.
# shellcheck disable=SC2016
mx_export() {
	local session="${1-}" linked first_window="" root="" window name layout
	local pane path command active_pane i
	local -a windows panes

	if [[ -z "$session" ]]; then
		if [[ -z ${TMUX-} ]]; then
			echo "mx: --export needs a session name outside tmux" >&2
			return 64
		fi
		session="$(tmux display-message -p '#{session_name}')"
	fi

	if ! tmux has-session -t "=$session" 2>/dev/null; then
		echo "mx: session not found: $session" >&2
		return 1
	fi

	mapfile -t windows < <(tmux list-windows -t "=$session" -F '#{window_index}')
	for window in "${windows[@]}"; do
		linked="$(tmux display-message -p -t "=$session:$window" '#{window_linked}')"
		[[ "$linked" == 1 ]] && continue
		mapfile -t panes < <(tmux list-panes -t "=$session:$window" -F '#{pane_index}')
		[[ ${#panes[@]} -gt 0 ]] || continue
		first_window="$window"
		root="$(tmux display-message -p -t "=$session:$window.${panes[0]}" '#{pane_current_path}')"
		break
	done

	if [[ -z "$first_window" ]]; then
		echo "mx: session has no unlinked windows: $session" >&2
		return 1
	fi

	printf '# Generated by mx --export from session %q.\n' "$session"
	printf '# Linked windows are omitted; mx appends _shared after mx_start.\n'
	printf '# Command comments only contain process names. Review the original arguments before adding send-keys.\n\n'
	printf 'MX_ROOT=%s\n\n' "$(export_root_expr "$root")"
	printf 'mx_start() {\n'
	printf '\tlocal window pane\n'
	printf '\tlocal -a panes\n\n'

	for window in "${windows[@]}"; do
		linked="$(tmux display-message -p -t "=$session:$window" '#{window_linked}')"
		[[ "$linked" == 1 ]] && continue

		name="$(tmux display-message -p -t "=$session:$window" '#{window_name}')"
		layout="$(tmux display-message -p -t "=$session:$window" '#{window_layout}')"
		mapfile -t panes < <(tmux list-panes -t "=$session:$window" -F '#{pane_index}')
		[[ ${#panes[@]} -gt 0 ]] || continue

		path="$(tmux display-message -p -t "=$session:$window.${panes[0]}" '#{pane_current_path}')"
		if [[ "$window" == "$first_window" ]]; then
			printf '\twindow=1\n'
			printf '\ttmux rename-window -t "=$MX_SESSION:$window" %q\n' "$name"
		else
			printf '\twindow="$(tmux new-window -d -P -F %q -t "=$MX_SESSION:" -n %q -c %s)"\n' \
				'#{window_index}' "$name" "$(export_dir_expr "$path" "$root")"
		fi
		printf '\tpanes=("$(tmux display-message -p -t "=$MX_SESSION:$window" %q)")\n' '#{pane_index}'

		active_pane=0
		for ((i = 0; i < ${#panes[@]}; i++)); do
			pane="${panes[$i]}"
			path="$(tmux display-message -p -t "=$session:$window.$pane" '#{pane_current_path}')"
			command="$(tmux display-message -p -t "=$session:$window.$pane" '#{pane_current_command}')"
			if [[ "$(tmux display-message -p -t "=$session:$window.$pane" '#{pane_active}')" == 1 ]]; then
				active_pane="$i"
			fi
			printf '\t# pane %d command: %q\n' "$((i + 1))" "$command"
			if ((i > 0)); then
				printf '\tpane="$(tmux split-window -d -P -F %q -t "=$MX_SESSION:$window" -c %s)"\n' \
					'#{pane_index}' "$(export_dir_expr "$path" "$root")"
				printf '\tpanes+=("$pane")\n'
			fi
		done

		if ((${#panes[@]} > 1)); then
			printf '\ttmux select-layout -t "=$MX_SESSION:$window" %q\n' "$layout"
		fi
		printf '\ttmux select-pane -t "=$MX_SESSION:$window.${panes[%d]}"\n\n' "$active_pane"
	done
	printf '}\n'
}

# mx --pick [query] - fuzzy-pick a project or defined session, then launch it
#   - Bypasses the finder when the query matches exactly one candidate (--select-1)
#   - Exits cleanly when there is no match or on cancel (--exit-0)
# Lines are --list TSV; fields 1-2 are shown, field 3 (abspath) rides along
# so the selection never has to be re-derived from display text.
mx_pick() {
	local line kind label path
	local fzf_opts=(
		--query="${1-}"
		--select-1
		--exit-0
		--no-multi
		--delimiter=$'\t'
		"--with-nth=1,2"
		--nth=2
		--tabstop=8
		--scheme=path
		--prompt="mx » "
		"--preview=COLORTERM=truecolor previewer {3}"
		"--preview-window=right:border-left:60%:hidden"
	)

	if [[ -n ${TMUX-} ]]; then
		fzf_opts+=("--popup=center,70%,70%" --border=none)
	else
		fzf_opts+=(--height=40%)
	fi

	line="$(list_candidates | fzf "${fzf_opts[@]}")" || return 0
	IFS=$'\t' read -r kind label path <<<"$line"

	case "$kind" in
	sess) main "$label" ;;
	dir) main --dir "$path" ;;
	esac
}

main() {
	local root="" session_file="" name="" matches=""

	case "${1-}" in
	--dir)
		[ $# -eq 2 ] || usage
		[ -d "${2-}" ] || usage
		root="$(cd "$2" && pwd)"
		name="$(derive_name "$root")"
		;;
	--list)
		[ $# -eq 1 ] || usage
		list_candidates
		exit 0
		;;
	--pick)
		[ $# -le 2 ] || usage
		mx_pick "${2-}"
		exit 0
		;;
	--export)
		[ $# -le 2 ] || usage
		mx_export "${2-}"
		exit $?
		;;
	-h | --help)
		[ $# -eq 1 ] || usage
		show_help
		;;
	--*)
		usage
		;;
	'')
		root="$PWD"
		name="$(basename "$PWD")"
		;;
	*)
		[ $# -eq 1 ] || usage
		name="$1"
		if ! session_file="$(find_session_file "$name")"; then
			session_file=""
			matches="$(resolve_dirs "$name")"
			if [ -n "$matches" ]; then
				if [ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]; then
					echo "mx: '$name' is ambiguous:" >&2
					printf '%s\n' "$matches" | sed 's/^/  /' >&2
					exit 1
				fi
				root="$matches"
				# same session name whether typed or picked
				name="$(derive_name "$root")"
			else
				root="$PWD"
			fi
		fi
		;;
	esac

	local tmux_name
	tmux_name="$(sanitize "$name")"

	if ! tmux has-session -t "=$tmux_name" 2>/dev/null; then
		mx-init

		if [ -n "$session_file" ]; then
			# shellcheck disable=SC1090
			source "$session_file"
			root="${MX_ROOT:-$PWD}"
		fi

		cd "$root"
		export MX_SESSION="$tmux_name"
		export MX_ROOT="$root"
		tmux new-session -d -s "$tmux_name" -c "$root"

		if [ -n "$session_file" ] && declare -F mx_start >/dev/null; then
			# `if !` suppresses errexit inside mx_start; a failing command in
			# a definition must not strand a half-built session before attach
			if ! mx_start; then
				echo "mx: mx_start for $tmux_name failed" >&2
				tmux display-message "mx: mx_start for $tmux_name failed" 2>/dev/null || true
			fi
		fi

		# Definition windows come first; shared windows are appended afterwards.
		link_shared_windows "$tmux_name"
		tmux select-window -t "=$tmux_name:1"
	fi

	if [ -z "${TMUX-}" ]; then
		exec tmux attach -t "=$tmux_name"
	else
		exec tmux switch-client -t "=$tmux_name"
	fi
}

main "$@"
