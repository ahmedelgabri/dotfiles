#!/usr/bin/env bash

# mx
# version 2.0

# Contributors:
#   Wynn Netherland - http://github.com/pengwynn
#   Adam Jahnke - http://github.com/adamyonk
#   Yoshua Wuyts - https://github.com/yoshuawuyts
#   Ahmed El Gabri - https://github.com/ahmedelgabri

# Usage:
#   mx                  session for $PWD (name = basename of $PWD)
#   mx <name>           session definition lookup, then project lookup by name
#   mx --dir <path>     plain session rooted exactly at <path>
#   mx --list           print session/project candidates as TSV
#   mx --pick [query]   fuzzy-pick a candidate and launch it
#
# Session definitions are plain bash files sourced by mx, looked up as
# $HOST_CONFIGS/tmux/sessions/<name> then $XDG_CONFIG_HOME/tmux/sessions/<name>.
# A definition may set MX_ROOT=<dir> and define mx_start(); mx creates the
# detached session at MX_ROOT, exports MX_SESSION and MX_ROOT, then calls
# mx_start synchronously. Inside mx_start every tmux command must target
# "=$MX_SESSION" explicitly: when mx runs from inside tmux, unqualified
# targets resolve against the caller's session, not the new one. mx_start
# runs with errexit suppressed, so a failing command inside it does not
# abort the layout or strand the session unattached.
#
# Project lookup resolves <name> against --list labels (exact match, or a
# unique /<name> suffix), so `mx git-wt` and `mx c/master` work from
# anywhere. No match falls back to a plain session at $PWD.

set -ue -o pipefail

if [[ -n "${DEBUG-}" ]]; then
	set -x
fi

usage() {
	echo "Usage: mx [<name>] | mx --dir <path> | mx --list | mx --pick [query]" >&2
	exit 64
}

sanitize() {
	# tmux forbids '.' and ':' in session names
	local s="${1//./_}"
	printf '%s\n' "${s//:/_}"
}

# Session definition search path; first hit wins
SESSION_DIRS=(
	"${HOST_CONFIGS:+$HOST_CONFIGS/tmux/sessions}"
	"${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions"
)

find_session_file() {
	local dir f
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] || continue
		f="$dir/$1"
		if [ -f "$f" ]; then
			printf '%s\n' "$f"
			return 0
		fi
	done
	return 1
}

# mx --list enumerates session candidates as TSV: <kind>\t<label>\t<abspath>
#   kind    = 'sess' (session definition file) or 'dir' (project directory)
#   label   = definition name, or dir path relative to $PROJECTS
#   abspath = the definition file for 'sess', the directory for 'dir'
#
# Root rules:
#   personal|trunk|forks|ahmedelgabri : every direct subdirectory
#   work/<org>/<project>              : every project; .bare projects also
#                                       list child worktrees (subdirs with .git)
#   archive                           : project children are leaves; other
#                                       children are grouping dirs whose child
#                                       dirs are candidates
#
# Deliberately uses shell globs instead of fd: a bare fd honors the global
# ignore file (config/.ignore) and would silently hide candidates, and fd -I
# would cost an external process per depth-1 listing for no gain over the
# builtin. nullglob makes missing roots and empty dirs a no-op, and plain */
# globs skip files and dotdirs.

shopt -s nullglob

emit() {
	printf '%s\t%s\t%s\n' "$1" "$2" "$3"
}

# A git repo, a git-wt bare layout, or a (possibly non-colocated) jj repo.
is_project() {
	[ -e "$1/.git" ] || [ -e "$1/.bare" ] || [ -e "$1/.jj" ]
}

# In a .bare layout only children holding a .git entry are worktrees; the
# filter keeps scratch dirs (e.g. work/<name>/c/_) out of the candidate list.
emit_worktrees() {
	local proj="$1" label="$2" wt
	for wt in "$proj"/*/; do
		wt="${wt%/}"
		[ -e "$wt/.git" ] || continue
		emit dir "$label/$(basename "$wt")" "$wt"
	done
}

list_sessions() {
	local dir f name
	local -A seen=()
	# $HOST_CONFIGS wins over the repo-tracked dir
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] && [ -d "$dir" ] || continue
		for f in "$dir"/*; do
			[ -f "$f" ] || continue
			name="$(basename "$f")"
			[ -n "${seen[$name]-}" ] && continue
			seen[$name]=1
			emit sess "$name" "$f"
		done
	done
}

list_flat() {
	local d
	for d in "$PROJECTS/$1"/*/; do
		d="${d%/}"
		emit dir "$1/$(basename "$d")" "$d"
	done
}

list_work() {
	local org proj label
	for org in "$PROJECTS/work"/*/; do
		org="${org%/}"
		for proj in "$org"/*/; do
			proj="${proj%/}"
			label="work/$(basename "$org")/$(basename "$proj")"
			emit dir "$label" "$proj"
			if [ -e "$proj/.bare" ]; then
				emit_worktrees "$proj" "$label"
			fi
		done
	done
}

list_archive() {
	local d label sub
	for d in "$PROJECTS/archive"/*/; do
		d="${d%/}"
		label="archive/$(basename "$d")"
		if is_project "$d"; then
			emit dir "$label" "$d"
			if [ -e "$d/.bare" ]; then
				emit_worktrees "$d" "$label"
			fi
		else
			for sub in "$d"/*/; do
				sub="${sub%/}"
				emit dir "$label/$(basename "$sub")" "$sub"
			done
		fi
	done
}

list_candidates() {
	: "${PROJECTS:?PROJECTS is not set}"
	list_sessions
	list_work
	list_flat trunk
	list_flat personal
	list_flat forks
	list_flat ahmedelgabri
	list_archive
}

resolve_dirs() {
	# all --list dir candidates whose label is $1 or ends in /$1
	list_candidates | awk -F'\t' -v n="$1" \
		'$1 == "dir" && ($2 == n || substr($2, length($2) - length(n)) == "/" n) { print $3 }'
}

derive_name() {
	local rel="${1#"${PROJECTS-}"/}"
	case "$rel" in
	work/*/*) rel="${rel#work/*/}" ;; # <project> or <project>/<worktree>
	forks/* | archive/*) ;;           # duplication is structural; keep qualified
	*) rel="${rel##*/}" ;;            # canonical homes: basename only
	esac
	printf '%s\n' "$rel"
}

link_shared_windows() {
	local name="$1"

	if tmux has-session -t "=_shared:mail" 2>/dev/null; then
		tmux link-window -s _shared:mail -t "=$name:6"
	fi

	if tmux has-session -t "=_shared:rss" 2>/dev/null; then
		tmux link-window -s _shared:rss -t "=$name:7"
	fi

	if tmux has-session -t "=_shared:HN" 2>/dev/null; then
		tmux link-window -s _shared:HN -t "=$name:8"
	fi

	if tmux has-session -t "=_shared:dotfiles" 2>/dev/null; then
		tmux link-window -s _shared:dotfiles -t "=$name:9"
	fi

	if tmux has-session -t "=_shared:notes" 2>/dev/null; then
		tmux link-window -s _shared:notes -t "=$name:10"
	fi
}

# mx --pick [query] - fuzzy-pick a project or defined session, then launch it
#   - Bypasses the finder when the query matches exactly one candidate (--select-1)
#   - Exits cleanly when there is no match or on cancel (--exit-0)
# Lines are --list TSV; fields 1-2 are shown, field 3 (abspath) rides along
# so the selection never has to be re-derived from display text.
mx_pick() {
	local line kind label path
	local fzf_opts=(
		--query="${1-}"
		--select-1
		--exit-0
		--no-multi
		--delimiter=$'\t'
		"--with-nth=1,2"
		--nth=2
		--tabstop=8
		--scheme=path
		--prompt="mx » "
		"--preview=COLORTERM=truecolor previewer {3}"
		"--preview-window=right:border-left:60%:hidden"
	)

	if [[ -n ${TMUX-} ]]; then
		fzf_opts+=("--popup=center,70%,70%" --border=none)
	else
		fzf_opts+=(--height=40%)
	fi

	line="$(list_candidates | fzf "${fzf_opts[@]}")" || return 0
	IFS=$'\t' read -r kind label path <<<"$line"

	case "$kind" in
	sess) main "$label" ;;
	dir) main --dir "$path" ;;
	esac
}

main() {
	local root="" session_file="" name="" matches=""

	case "${1-}" in
	--dir)
		[ $# -eq 2 ] || usage
		[ -d "${2-}" ] || usage
		root="$(cd "$2" && pwd)"
		name="$(derive_name "$root")"
		;;
	--list)
		[ $# -eq 1 ] || usage
		list_candidates
		exit 0
		;;
	--pick)
		[ $# -le 2 ] || usage
		mx_pick "${2-}"
		exit 0
		;;
	--*)
		usage
		;;
	'')
		root="$PWD"
		name="$(basename "$PWD")"
		;;
	*)
		[ $# -eq 1 ] || usage
		name="$1"
		if ! session_file="$(find_session_file "$name")"; then
			session_file=""
			matches="$(resolve_dirs "$name")"
			if [ -n "$matches" ]; then
				if [ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]; then
					echo "mx: '$name' is ambiguous:" >&2
					printf '%s\n' "$matches" | sed 's/^/  /' >&2
					exit 1
				fi
				root="$matches"
				# same session name whether typed or picked
				name="$(derive_name "$root")"
			else
				root="$PWD"
			fi
		fi
		;;
	esac

	local tmux_name
	tmux_name="$(sanitize "$name")"

	if ! tmux has-session -t "=$tmux_name" 2>/dev/null; then
		mx-init

		if [ -n "$session_file" ]; then
			# shellcheck disable=SC1090
			source "$session_file"
			root="${MX_ROOT:-$PWD}"
		fi

		cd "$root"
		export MX_SESSION="$tmux_name"
		export MX_ROOT="$root"
		tmux new-session -d -s "$tmux_name" -c "$root"

		# linked before mx_start so 6-10 are taken and definition windows
		# fill 2-5 then skip past - no "index in use" abort
		link_shared_windows "$tmux_name"

		if [ -n "$session_file" ] && declare -F mx_start >/dev/null; then
			# `if !` suppresses errexit inside mx_start; a failing command in
			# a definition must not strand a half-built session before attach
			if ! mx_start; then
				echo "mx: mx_start for $tmux_name failed" >&2
				tmux display-message "mx: mx_start for $tmux_name failed" 2>/dev/null || true
			fi
		fi

		tmux select-window -t "=$tmux_name:1"
	fi

	if [ -z "${TMUX-}" ]; then
		exec tmux attach -t "=$tmux_name"
	else
		exec tmux switch-client -t "=$tmux_name"
	fi
}

main "$@"
