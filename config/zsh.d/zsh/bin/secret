#!/usr/bin/env bash
set -ue -o pipefail
# vim:ft=bash:
# secret - store & retrieve tokens in the macOS login keychain
#
# Values never appear in `security`'s argv (visible to `ps`) or on disk:
# `set` reads from a hidden prompt or stdin and hands the value to
# `security -i` over a pipe. Items are tagged via -D so `ls` only shows
# entries owned by this script.

KIND='dotfiles secret'
ACCOUNT="$USER"

usage() {
	cat <<EOF
Usage: secret <command> [name]

  set <name>   store or rotate a secret; prompts silently,
               or reads stdin: pbpaste | secret set <name>
  get <name>   print a secret
  ls           list secrets managed by this script
  rm <name>    delete a secret

Shell startup usage: export GITHUB_TOKEN="\$(secret get github-token)"
EOF
}

# security's interactive parser reads double-quoted strings with
# backslash escapes.
escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

cmd="${1-}"
name="${2-}"

require_name() {
	if [ -z "$name" ]; then
		echo "secret: $cmd needs a name" >&2
		exit 1
	fi
}

case "$cmd" in
set)
	require_name
	if [ -t 0 ]; then
		# Interactive: security does its own hidden prompt + confirmation.
		security add-generic-password -U -a "$ACCOUNT" -s "$name" -D "$KIND" -w
	else
		value="$(cat)"
		if [ -z "$value" ]; then
			echo "secret: refusing to store an empty value" >&2
			exit 1
		fi
		case "$value" in
		*$'\n'*)
			# security -i commands are line-based; a newline would
			# truncate the stored value.
			echo "secret: value must be a single line" >&2
			exit 1
			;;
		esac
		printf 'add-generic-password -U -a "%s" -s "%s" -D "%s" -w "%s"\n' \
			"$(escape "$ACCOUNT")" "$(escape "$name")" "$(escape "$KIND")" "$(escape "$value")" |
			security -i >/dev/null
	fi
	# Read back so a swallowed `security -i` failure can't fake success.
	security find-generic-password -a "$ACCOUNT" -s "$name" -w >/dev/null
	echo "secret: stored '$name' in the login keychain" >&2
	;;
get)
	require_name
	if ! security find-generic-password -a "$ACCOUNT" -s "$name" -w 2>/dev/null; then
		echo "secret: could not read '$name' from the login keychain" >&2
		exit 1
	fi
	;;
ls)
	security dump-keychain | awk -v marker="\"desc\"<blob>=\"$KIND\"" '
			/^keychain:/ { found = 0 }
			index($0, marker) { found = 1 }
			found && /"svce"<blob>=/ {
				line = $0
				sub(/^.*"svce"<blob>="/, "", line)
				sub(/"$/, "", line)
				print line
				found = 0
			}
		' | sort -u
	;;
rm)
	require_name
	if ! security delete-generic-password -a "$ACCOUNT" -s "$name" >/dev/null 2>&1; then
		echo "secret: '$name' not found in the login keychain" >&2
		exit 1
	fi
	echo "secret: removed '$name'" >&2
	;;
*)
	usage >&2
	exit 1
	;;
esac
