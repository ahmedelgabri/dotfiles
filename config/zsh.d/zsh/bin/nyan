#!/usr/bin/env bash
set -ue -o pipefail

e=$'\033'
RESET="${e}[0m"
BOLD="${e}[1m"
CYAN="${e}[0;96m"
RED="${e}[0;91m"
YELLOW="${e}[0;93m"
GREEN="${e}[0;92m"

if [ "${1-}" = "-alt" ]; then
	printf '%s%s' "$RED" '`·.,¸,.·*·.'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" '╭━━━━╮' "$RESET"
	printf '%s%s' "$YELLOW" '`·.,¸,.·*·.'
	printf '%s%s%s\\%s\n' "$RESET" "$BOLD" '|::: /\_/' "$RESET"
	printf '%s%s' "$GREEN" '`·.,¸,.·*·.'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" '|:::( ◕ᴥ◕)' "$RESET"
	printf '%s%s' "$CYAN" '`·.,¸,.·*·.'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" 'u-u━━-u--u' "$RESET"
else
	printf '%s%s' "$RED" '-_-_-_-_-_-_-_'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" ',------,' "$RESET"
	printf '%s%s' "$YELLOW" '_-_-_-_-_-_-_-'
	printf '%s%s%s\\%s\n' "$RESET" "$BOLD" '|   /\_/' "$RESET"
	printf '%s%s' "$GREEN" '-_-_-_-_-_-_-'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" '~|__( ^ .^)' "$RESET"
	printf '%s%s' "$CYAN" '-_-_-_-_-_-_-'
	printf '%s%s%s%s\n' "$RESET" "$BOLD" '""  ""' "$RESET"
fi
