#!/usr/bin/env bash
set -ue -o pipefail
# vim:ft=bash:
# fco - checkout git branch/tag

fco() {
	local tags branches target
	local fzf_opts=(
		--no-hscroll
		--reverse
		--no-multi
		--delimiter=$'\t'
		--nth=2
		--accept-nth=2
		--ansi
		--preview="git --no-pager log -150 --oneline '..{2}'"
	)

	if [[ -n ${TMUX-} ]]; then
		fzf_opts+=("--popup=center,90%,80%" --border=none)
	fi

	branches=$(git --no-pager branch --all \
		--format="%(if)%(HEAD)%(then)%(else)%(if:equals=HEAD)%(refname:strip=3)%(then)%(else)%1B[0;34;1mbranch%09%1B[m%(refname:short)%(end)%(end)" |
		sed '/^$/d') || return
	tags=$(git --no-pager tag | awk '{print "\x1b[35;1mtag\x1b[m\t" $1}') || return
	target=$(
		(
			echo "$branches"
			echo "$tags"
		) | fzf "${fzf_opts[@]}"
	) || return
	git checkout "$target"
}

fco "$@"
