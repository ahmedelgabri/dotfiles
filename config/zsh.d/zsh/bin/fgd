#!/usr/bin/env bash
set -ue -o pipefail
# fgd - delete git branch/tag

fgd() {
	local tags branches selection type target
	local fzf_opts=(
		--reverse
		--no-hscroll
		--ansi
		--no-multi
		--delimiter=$'\t'
		--nth=2
		--header='Select a branch or tag to delete'
		--preview='git --no-pager log -150 --oneline {2}'
	)

	if [[ -n ${TMUX-} ]]; then
		fzf_opts+=("--popup=center,90%,80%" --border=none)
	fi

	tags=$(
		git tag | awk '{print "\x1b[31;1mtag\x1b[m\t" $1}'
	) || return
	branches=$(
		git branch --all | grep -v HEAD |
			sed "s/.* //" | sed "s#remotes/[^/]*/##" |
			sort -u | awk '{print "\x1b[34;1mbranch\x1b[m\t" $1}'
	) || return
	selection=$(
		(
			echo "$tags"
			echo "$branches"
		) | fzf "${fzf_opts[@]}"
	) || return

	IFS=$'\t' read -r type target <<<"$selection"
	case "$type" in
	tag)
		echo "$target"
		git tag -d "$target"
		;;
	branch)
		echo "$target"
		git branch -D "$target"
		;;
	esac
}

fgd "$@"
