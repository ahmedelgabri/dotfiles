#!/usr/bin/env sh
set -ue -o pipefail
# Show stats about files edited, lines deleted/added & total lines modified
# from https://gist.github.com/eyecatchup/3fb7ef0c0cbdb72412fc

git log --shortstat --author="$1" |
grep -E "fil(e|es) changed" |
awk '{
	files += $1
	# Match on the insertion/deletion labels instead of fixed positions:
	# a deletions-only line has no insertions field, so $4/$6 shift.
	for (i = 2; i <= NF; i++) {
		if ($i ~ /insertion/) inserted += $(i - 1)
		if ($i ~ /deletion/) deleted += $(i - 1)
	}
}
END {
	delta = inserted - deleted
	ratio = (inserted > 0) ? deleted / inserted : 0
	printf "Commit stats:\n- Files changed (total)..  %s\n- Lines added (total)....  %s\n- Lines deleted (total)..  %s\n- Total lines (delta)....  %s\n- Add./Del. ratio (1:n)..  1 : %s\n", files, inserted, deleted, delta, ratio
}' -
