#!/usr/bin/env bash
set -ue -o pipefail

# Shell commands run by coding agents (Claude Code, Codex, pi) are kept in
# their own history next to .zsh_history instead of inside it, so they never
# surface in up-arrow, substring search, or inline suggestions while staying
# searchable from the Ctrl-R widget in config/zsh.d/zsh/config/extras.zsh.
#
# Usage:
#   agent-history record <agent>    # Claude-Code-style hook JSON on stdin
#   agent-history list [--dir DIR | --repo DIR] [--agent NAME]
#                      [--session ID] [--all]
#                                   # NUL-separated "id\ttime\tdir\tcmd",
#                                   # newest first, one row per command;
#                                   # id is always empty; --all keeps every
#                                   # row, failed calls included
#   agent-history show [FILTERS] -- CMD  # newest record of CMD in scope
#   agent-history forget CMD        # delete every record of CMD
#   agent-history import-atuin [PATH]  # copy agent-run rows out of atuin
#
# Storage is SQLite: concurrent agents get atomic writes and a busy timeout
# from the engine, and `list` is a query rather than a scan of a growing
# file. The widget uses the same four columns for shell history, where id is
# the history number.

db="${ZDOTDIR:-$HOME}/.agent_history.db"

# Generic credential shapes plus provider token shapes (AWS, GitHub, Slack,
# Stripe, Anthropic, OpenAI, GitLab, npm, Google) and PEM private keys.
# Agents paste tokens into commands more readily than a human typing at a
# prompt does. The sk- shapes keep a leading \b so names like "task-..." pass,
# and the legacy OpenAI shape allows no dashes so kebab-case names do too.
secret_pattern='\b[A-Z_]*(TOKEN|SECRET|PASSWORD|API_?KEY)[A-Z_]*='
secret_pattern+='|--(password|token|secret|api-key)[= ]'
secret_pattern+='|authorization: ?(bearer|basic) '
secret_pattern+='|^sshpass '
secret_pattern+='|gh auth login --with-token'
secret_pattern+='|AKIA[0-9A-Z]{16}'
secret_pattern+='|gh[pousr]_[A-Za-z0-9]{36,}'
secret_pattern+='|github_pat_[A-Za-z0-9_]{22,}'
secret_pattern+='|xox[baprs]-[0-9A-Za-z-]{10,}'
secret_pattern+='|hooks\.slack\.com/services/'
secret_pattern+='|[sr]k_(live|test)_[0-9A-Za-z]{24,}'
secret_pattern+='|\bsk-ant-(api|admin|oat)[0-9]{2}-[A-Za-z0-9_-]{20,}'
secret_pattern+='|\bsk-(proj|svcacct|admin)-[A-Za-z0-9_-]{40,}'
secret_pattern+='|\bsk-[A-Za-z0-9]{48}\b'
secret_pattern+='|glpat-[A-Za-z0-9_-]{20,}'
secret_pattern+='|\bnpm_[A-Za-z0-9]{36}\b'
secret_pattern+='|AIza[0-9A-Za-z_-]{35}'
secret_pattern+='|-----BEGIN [A-Z ]*PRIVATE KEY'

fail() {
	echo "agent-history: $*" >&2
	exit 1
}

# Waits up to five seconds for a writer holding the database, then fails.
sql() {
	sqlite3 -cmd '.timeout 5000' "$db" "$@"
}

ensure_db() {
	local version err
	# Only the first run creates files; 077 keeps the database and its WAL
	# companions private without touching an existing database's mode.
	umask 077
	version=$(sql 'PRAGMA user_version;') || return 1
	((version >= 1)) && return 0

	# Fresh and version-0 databases take the same path: the CREATE is a no-op
	# for the latter and the ALTERs add what it lacks. The whole migration is
	# one SQL argument, which sqlite3 abandons at the first error, so a failed
	# ALTER can never fall through to bumping the version. BEGIN IMMEDIATE
	# queues concurrent hooks; the one that loses fails on a duplicate column
	# and finds the version already bumped by the winner.
	#
	# Switching to WAL returns "database is locked" at once, ignoring the busy
	# timeout, while another process is switching the same file. The process
	# that wins does the switch, and a real write failure still surfaces from
	# the migration, so losing that race is not an error.
	sql 'PRAGMA journal_mode = WAL;' >/dev/null 2>&1 || true
	err=$(sql 'BEGIN IMMEDIATE;
		CREATE TABLE IF NOT EXISTS commands (
			id INTEGER PRIMARY KEY,
			ts INTEGER NOT NULL,
			agent TEXT NOT NULL,
			cwd TEXT NOT NULL,
			cmd TEXT NOT NULL
		);
		ALTER TABLE commands ADD COLUMN session TEXT NOT NULL DEFAULT '"''"';
		ALTER TABLE commands ADD COLUMN status TEXT NOT NULL DEFAULT '"'ran'"';
		ALTER TABLE commands ADD COLUMN description TEXT NOT NULL DEFAULT '"''"';
		CREATE INDEX IF NOT EXISTS commands_ts ON commands (ts);
		CREATE INDEX IF NOT EXISTS commands_cwd ON commands (cwd);
		CREATE INDEX IF NOT EXISTS commands_session ON commands (session);
		PRAGMA user_version = 1;
		COMMIT;' 2>&1 >/dev/null) && return 0
	version=$(sql 'PRAGMA user_version;') || return 1
	((version >= 1)) && return 0
	echo "agent-history: $err" >&2
	return 1
}

# SQL string literal: single quotes doubled.
quote() {
	local s=${1//\'/\'\'}
	printf "'%s'" "$s"
}

record() {
	local agent="${1:?agent name required}"
	local statement
	# A payload without a Bash command (other tools, or a filtered secret) is
	# a no-op; a payload that is not JSON at all is a real failure. jq builds
	# the INSERT so the command never passes through shell word splitting.
	# PostToolUseFailure is Claude's report of any failed call (denied,
	# interrupted, tool error); Codex and pi never send it, so "failed" is the
	# hook's classification, not an exit status.
	statement=$(jq -r --arg agent "$agent" --arg re "$secret_pattern" '
		def q: "'"'"'" + gsub("'"'"'"; "'"''"'") + "'"'"'";
		def str: if type == "string" then . else "" end;
		(.tool_input.command // empty | strings) as $cmd
		| (.tool_input.description | str) as $description
		| select(any($cmd, $description; test($re; "i")) | not)
		| "INSERT INTO commands (ts, agent, cwd, cmd, session, status, description) VALUES ("
			+ (now | floor | tostring) + ", " + ($agent | q) + ", "
			+ ((.cwd // "") | q) + ", " + ($cmd | q) + ", "
			+ (.session_id | str | q) + ", "
			+ (if .hook_event_name == "PostToolUseFailure" then "failed" else "ran" end | q) + ", "
			+ ($description | q) + ");"
	') || fail "could not parse hook payload"
	[[ -n $statement ]] || return 0

	ensure_db || fail "could not open $db"
	sql "$statement" || fail "could not write $db"
}

# atuin marks agent-run commands with author_kind 2 and applied the same
# credential filters when recording them, so rows are copied as they are.
# Re-running skips rows that are already present.
import-atuin() {
	local src="${1:-${XDG_DATA_HOME:-$HOME/.local/share}/atuin/history.db}"
	local imported
	[[ -r $src ]] || fail "no atuin database at $src"
	ensure_db || fail "could not open $db"
	imported=$(sql "ATTACH DATABASE $(quote "$src") AS atuin;
		INSERT INTO commands (ts, agent, cwd, cmd)
		SELECT h.timestamp / 1000000000,
			CASE h.author WHEN 'claude-code' THEN 'claude' ELSE h.author END,
			h.cwd, h.command
		FROM atuin.history AS h
		WHERE h.author_kind = 2 AND h.deleted_at IS NULL
			AND NOT EXISTS (
				SELECT 1 FROM commands AS c
				WHERE c.ts = h.timestamp / 1000000000 AND c.cwd = h.cwd AND c.cmd = h.command)
		ORDER BY h.timestamp;
		SELECT changes();") || fail "could not import from $src"
	echo "agent-history: imported $imported commands from $src"
}

dir_condition() {
	local dir=$1
	# Strip trailing slashes so "DIR/" prefix matching works, and let the
	# root match everything rather than looking for "//".
	while [[ ${#dir} -gt 1 && $dir == */ ]]; do
		dir="${dir%/}"
	done
	[[ $dir == / ]] && return 0
	conditions+=("cwd = $(quote "$dir") OR substr(cwd, 1, length($(quote "$dir")) + 1) = $(quote "$dir/")")
}

# The jj workspace or git worktree holding DIR, else DIR itself, so "agents
# here" covers the whole checkout from any subdirectory.
repo_root() {
	local dir=$1 root
	root=$(cd "$dir" 2>/dev/null && jj --ignore-working-copy root 2>/dev/null) ||
		root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) ||
		root=$dir
	printf '%s' "$root"
}

# Fills the globals `conditions` (SQL predicates, ANDed by where_clause) and
# `all` from filter flags, and `rest` with whatever follows `--`.
parse_filters() {
	conditions=()
	all=""
	rest=()
	while (($#)); do
		case $1 in
		--)
			shift
			rest=("$@")
			break
			;;
		--dir)
			dir_condition "${2:?directory required}"
			shift 2
			;;
		--repo)
			dir_condition "$(repo_root "${2:?directory required}")"
			shift 2
			;;
		--agent)
			conditions+=("agent = $(quote "${2:?agent required}")")
			shift 2
			;;
		--session)
			conditions+=("session = $(quote "${2:?session required}")")
			shift 2
			;;
		--all)
			all=1
			shift
			;;
		*) fail "unknown option: $1" ;;
		esac
	done
	[[ -n $all ]] || conditions+=("status != 'failed'")
}

# Each predicate is parenthesised so an OR inside one cannot escape the AND.
where_clause() {
	local keyword=WHERE condition
	for condition in "${conditions[@]}"; do
		printf ' %s (%s)' "$keyword" "$condition"
		keyword=AND
	done
}

list() {
	local conditions all rest newest_only="WHERE n = 1"
	parse_filters "$@"
	((${#rest[@]} == 0)) || fail "list takes no command"
	[[ -f $db ]] || return 0
	ensure_db || fail "could not open $db"
	# Agents repeat the same commands constantly, so by default each command
	# appears once, at its newest occurrence within the filters.
	[[ -n $all ]] && newest_only=""
	# sqlite3 cannot emit a NUL row separator from the command line, so the
	# rows go out as JSON and jq frames them for fzf --read0.
	sql -json "SELECT strftime('%Y-%m-%d %H:%M', ts, 'unixepoch', 'localtime') AS time, cwd, cmd
		FROM (
			SELECT id, ts, cwd, cmd,
				ROW_NUMBER() OVER (PARTITION BY cmd ORDER BY ts DESC, id DESC) AS n
			FROM commands$(where_clause)
		) $newest_only
		ORDER BY ts DESC, id DESC;" |
		jq -j '.[] | "\t\(.time)\t\(.cwd)\t\(.cmd)\u0000"'
}

# The preview for a picker row. It takes the picker's filters so the
# metadata comes from the row being shown, not a newer run of the same
# command outside that scope.
show() {
	local conditions all rest
	parse_filters "$@"
	((${#rest[@]} == 1)) || fail "usage: show [FILTERS] -- CMD"
	[[ -f $db ]] || return 0
	ensure_db || fail "could not open $db"
	conditions+=("cmd = $(quote "${rest[0]}")")
	sql -json "SELECT strftime('%Y-%m-%d %H:%M', ts, 'unixepoch', 'localtime') AS time,
			agent, status, cwd, session, description, cmd
		FROM commands$(where_clause) ORDER BY ts DESC, id DESC LIMIT 1;" |
		jq -r '.[]
			| "\(.time)  \(.agent)  \(.status)", "dir: \(.cwd)",
				(select(.session != "") | "session: \(.session)"),
				(select(.description != "") | "description: \(.description)"),
				"", .cmd'
}

# Removes every copy so an older duplicate cannot take the forgotten row's
# place in the deduplicated list. secure_delete overwrites the freed content
# and the checkpoint folds the WAL back into the database, but a busy
# checkpoint is skipped, so this is logical deletion with best-effort
# scrubbing, not secure erasure. Nothing matching is success: another picker
# may have removed it first.
forget() {
	local count
	(($# == 1)) || fail "usage: forget CMD"
	[[ -f $db ]] || return 0
	ensure_db || fail "could not open $db"
	count=$(sql "PRAGMA secure_delete = ON;
		DELETE FROM commands WHERE cmd = $(quote "$1");
		SELECT changes();") || fail "could not write $db"
	sql 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null 2>&1 || true
	echo "agent-history: forgot ${count##*$'\n'} records" >&2
}

case "${1:-}" in
record | list | show | forget | import-atuin)
	cmd="$1"
	shift
	"$cmd" "$@"
	;;
*)
	echo "usage: agent-history record <agent> | list [--dir DIR | --repo DIR] [--agent NAME] [--session ID] [--all] | show [FILTERS] -- CMD | forget CMD | import-atuin [PATH]" >&2
	exit 64
	;;
esac
