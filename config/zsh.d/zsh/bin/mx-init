#!/usr/bin/env bash
set -ue -o pipefail

if [[ -n "${DEBUG-}" ]]; then
	set -x
fi

SESSION='_shared'

# Targets are fully qualified with "=$SESSION": when mx-init runs from inside
# tmux, unqualified new-window/send-keys resolve against the caller's current
# session, not _shared.
create_session() {
	tmux new-session -d -s "$SESSION"

	if
		command -v aerc &>/dev/null
	then
		tmux new-window -t "=$SESSION:" -n 'mail'
		tmux send-keys -t "=$SESSION:mail" "aerc" C-m
	fi

	if
		command -v newsraft &>/dev/null
	then
		tmux new-window -t "=$SESSION:" -n 'rss'
		tmux send-keys -t "=$SESSION:rss" "newsraft" C-m
	fi

	if command -v clx &>/dev/null; then
		tmux new-window -t "=$SESSION:" -n 'HN'
		tmux send-keys -t "=$SESSION:HN" "clx" C-m
	fi

	if [ -d "${NOTES_DIR-}" ]; then
		tmux new-window -t "=$SESSION:" -n 'notes' -c "$NOTES_DIR"
		tmux send-keys -t "=$SESSION:notes" "$EDITOR" C-m
	fi

	if [ -d "${DOTFILES-}" ]; then
		tmux new-window -t "=$SESSION:" -n 'dotfiles' -c "$DOTFILES"
		tmux send-keys -t "=$SESSION:dotfiles" "$EDITOR" C-m
		tmux split-window -h -l 15% -t "=$SESSION:dotfiles" -c "$DOTFILES"
	fi
}

if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
	create_session
fi
