#!/usr/bin/env sh
set -ue -o pipefail
# Kills all processes running on the specified port (e.g. 'killport 8080')

# lsof exits 1 when nothing listens (which pipefail would propagate) and
# GNU xargs needs -r to skip running kill with no PIDs.
{ lsof -i tcp:"$1" || true; } | awk '(NR!=1) && ($1!="Google") && ($1!="firefox") && ($1!="helium") {print $2}' | xargs -r kill
