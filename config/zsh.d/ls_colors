# eza-only UI keys, routed into EZA_COLORS: ur/gr/tr uw/gw/tw ux/ue/gx/tx =
# user/group/other permission bits (read, write, exec), uu = the current
# user's name, da = date. "reset" must come first: it disables eza's built-in
# filetype styles so the entries above are the only file colors.
eza:reset
eza:ur=35
eza:gr=35
eza:tr=35
eza:uw=34
eza:gw=34
eza:tw=34
eza:ux=36
eza:ue=36
eza:gx=36
eza:tx=36
eza:uu=36
eza:da=2
