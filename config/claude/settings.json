{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"cleanupPeriodDays": 99999,
	"env": {
		"BASH_DEFAULT_TIMEOUT_MS": "120000",
		"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
		"CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "64000",
		"CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1",
		"CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
		"DISABLE_ERROR_REPORTING": "1",
		"USE_BUILTIN_RIPGREP": "0"
	},
	"includeCoAuthoredBy": false,
	"permissions": {
		"defaultMode": "auto"
	},
	"model": "claude-fable-5[1m]",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh SessionStart",
						"async": true
					},
					{
						"type": "command",
						"command": "~/.claude/hooks/inject-repo-info.sh",
						"statusMessage": "Loading repo VCS info…"
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state idle",
						"type": "command"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PostCompact",
						"async": true
					},
					{
						"type": "command",
						"command": "~/.claude/hooks/inject-repo-info.sh",
						"statusMessage": "Loading repo VCS info…",
						"asyncRewake": true
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh SessionEnd",
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state clear",
						"type": "command"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh UserPromptSubmit",
						"async": true
					},
					{
						"type": "command",
						"command": "~/.claude/hooks/aggregate-prompt.sh UserPromptSubmit",
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state running",
						"type": "command"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PreToolUse",
						"async": true
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/validate-bash.sh"
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state running",
						"type": "command"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PostToolUse",
						"async": true
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh Stop",
						"async": true
					},
					{
						"type": "command",
						"command": "ccpeek --index-only --skip-scan --quiet >> ~/Library/Logs/ccpeek-stdout.log 2>> ~/Library/Logs/ccpeek-stderr.log",
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state idle",
						"type": "command"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh SubagentStop",
						"async": true
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh Notification",
						"async": true
					},
					{
						"type": "command",
						"command": "[[ -z \"$GHOSTTY_BIN_DIR\" ]] && jq -r '.message' | terminal-notifier -title Claude -subtitle \"Notification hook\" -activate com.mitchellh.ghostty || true"
					}
				]
			},
			{
				"hooks": [
					{
						"async": true,
						"command": "tap state notification",
						"type": "command"
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/log-event.sh PreCompact",
						"async": true
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "~/.claude/scripts/statusline.sh"
	},
	"enabledPlugins": {
		"claude-md-management@claude-plugins-official": true,
		"feature-dev@claude-plugins-official": true,
		"hookify@claude-plugins-official": true,
		"skill-creator@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"qmd@qmd": true
	},
	"extraKnownMarketplaces": {
		"qmd": {
			"source": {
				"source": "github",
				"repo": "tobi/qmd"
			}
		}
	},
	"alwaysThinkingEnabled": true
}
