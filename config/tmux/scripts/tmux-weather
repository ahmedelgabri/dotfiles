#!/usr/bin/env bash

set -u -o pipefail

command -v weather >/dev/null 2>&1 || exit 0

TMP_WEATHER_FILE="${TMPDIR:-/tmp}/weather.tmp"
REFRESH_RATE=$((60 * 60)) # seconds (1 hour)

_load_weather() {
	# Only refresh when online; keep serving stale data otherwise.
	ping -q -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || return 0
	weather "" "format=%c+%t+%h+%w+%m" >"$TMP_WEATHER_FILE"
	printf '\n%s' "$(date +'%s')" >>"$TMP_WEATHER_FILE"
}

[[ -f "$TMP_WEATHER_FILE" ]] || _load_weather

# Offline with no cache: stay silent instead of erroring on tail/head
# against a nonexistent file every status refresh.
[[ -f "$TMP_WEATHER_FILE" ]] || exit 0

now="$(date +'%s')"
epoch="$(tail -n 1 "$TMP_WEATHER_FILE")"
delta="$((now - ${epoch:-0}))"

[[ $delta -gt $REFRESH_RATE ]] && _load_weather

weather_data="$(head -n 1 "$TMP_WEATHER_FILE")"
weather_data="${weather_data//+/}"

[[ -n "$weather_data" ]] || exit 0

# Emit the separator with the data (like tmux-battery) so an empty
# segment leaves no dangling separator in the status bar.
printf "#[fg=brightblack]%s#[fg=black] ⦁ " "$weather_data"
