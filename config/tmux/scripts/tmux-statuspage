#!/usr/bin/env bash

# Incident indicator for any statuspage.io-hosted status page.
# Usage: tmux-statuspage <name> <statuspage-id> <icon>
# The icon may be a raw glyph or a printf escape like '\uE709'.
# API: https://<statuspage-id>.statuspage.io/api/v2/status.json

NAME="${1:?usage: tmux-statuspage <name> <statuspage-id> <icon>}"
PAGE_ID="${2:?missing statuspage id}"
ICON="$(printf -- "${3:?missing icon}")"

CACHE_FILE="$TMPDIR/.tmux-${NAME}-status.tmp"
CACHE_TTL=$((5 * 60)) # 5 minutes

_fetch_status() {
	local status
	status=$(curl -sS --max-time 5 "https://${PAGE_ID}.statuspage.io/api/v2/status.json" | jq -r '.status.indicator')
	printf "%s\n%s" "$status" "$(date +'%s')" >"$CACHE_FILE"
	printf "%s" "$status"
}

_get_status() {
	if [[ -f "$CACHE_FILE" ]]; then
		local now epoch delta
		now="$(date +'%s')"
		epoch="$(tail -n 1 "$CACHE_FILE")"
		delta="$((now - epoch))"
		if [[ $delta -gt $CACHE_TTL ]]; then
			_fetch_status
		else
			head -n 1 "$CACHE_FILE"
		fi
	else
		_fetch_status
	fi
}

SERVICE_STATUS=$(_get_status)

INDICATOR="#[fg=brightblack]⦁"
ICON_MAINTENANCE="$(printf '\uE20F')"

case $SERVICE_STATUS in
maj* | cri*)
	STATUS="#[fg=red] ${ICON}  $INDICATOR "
	;;
mi*)
	STATUS="#[fg=yellow] ${ICON}  $INDICATOR "
	;;
mai*)
	STATUS="#[fg=yellow] ${ICON_MAINTENANCE}  $INDICATOR "
	;;
*)
	STATUS=""
	;;
esac

printf "%s" "$STATUS"
