# aerc default styleset
#
# This styleset uses the terminal defaults as its base.
# More information on how to configure the styleset can be found in
# the aerc-styleset(7) manpage. Please read the manual before
# modifying or creating a styleset.

# reset everything
*.default=true
*.normal=true

title.reverse=true
header.fg=8

*error.fg=1
*warning.fg=3
*success.fg=2

*.selected.fg=4
*.selected.bg=black
*.selected.bold=false

# scrollbars
*_pill.bg=black

statusline*.default=true
statusline_default.fg=8
statusline_error.fg=1
statusline_error.reverse=true

msglist_unread.bold=false
msglist_read.fg=8
msglist_marked.fg=3
msglist_deleted.fg=1

dirlist_default.fg=8
dirlist_unread.fg=8

completion_description.fg=8

border.bg=false
tab.selected.bg=false
tab.fg=8

border.bg=false

selector_chooser.bold=true

spinner.fg=8

# Colorize
[viewer]
url.underline=true

