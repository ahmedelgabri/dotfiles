{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "zh record codex"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "@injectRepoInfo@",
						"statusMessage": "Loading repo VCS info…"
					},
					{
						"type": "command",
						"command": "@mxResume@ codex",
						"timeout": 5
					}
				]
			}
		]
	}
}
