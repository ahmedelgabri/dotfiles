{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "zh record codex"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "@injectRepoInfo@",
						"statusMessage": "Loading repo VCS info…"
					},
					{
						"type": "command",
						"command": "@codexResume@",
						"timeout": 5
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh -c 'rex __internal session-start --agent codex --feature-session-naming=false 2>/dev/null || true'",
						"timeout": 5,
						"statusMessage": "Loading Rex terminal context"
					}
				]
			}
		]
	}
}
