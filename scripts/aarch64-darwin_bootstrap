#!/usr/bin/env bash

set -Eueo pipefail

FLAKE=${1:-$(hostname -s)}

print_main_banner

# =======================================================================
# = Main functions
# =======================================================================

if xcode-select -p >/dev/null 2>&1; then
	log_info "Xcode already installed"
else
	log_info "Installing Xcode (confirm the GUI prompt)"
	xcode-select --install

	# xcode-select --install returns immediately after opening the GUI
	# prompt; wait for the CLT to actually land before nix needs it.
	until xcode-select -p >/dev/null 2>&1; do
		sleep 5
	done
	log_success "Xcode installed"
fi

# Independent of the Xcode branch: a machine with CLT present but Rosetta
# absent still needs Rosetta (nix-homebrew's x86 prefix assumes it).
if arch -arch x86_64 /usr/bin/true 2>/dev/null; then
	log_info "Rosetta already installed"
else
	log_info "Installing Rosetta"
	sudo softwareupdate --install-rosetta --agree-to-license
	log_success "Rosetta installed"
fi

if [ -e "$DOTFILES_DIR/flake.nix" ]; then
	FLAKE_ROOT="$DOTFILES_DIR"
elif [ -n "${BOOTSTRAP_FLAKE_ROOT:-}" ]; then
	FLAKE_ROOT="$BOOTSTRAP_FLAKE_ROOT"
else
	log_error "Could not find a flake source for bootstrap"
fi

log_info "Installing flake -> $FLAKE"
sudo nix --experimental-features 'nix-command flakes' run nix-darwin -- switch --option eval-cache false --flake "$FLAKE_ROOT#$FLAKE"
log_success "$FLAKE installed"

clone_dotfiles

log_success "Done."
log_info "Don't forget to generate SSH keys & import gpg keys"
