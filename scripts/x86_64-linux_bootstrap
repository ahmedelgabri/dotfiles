#!/usr/bin/env bash
# Inlined via builtins.readFile into writeShellApplication (see
# nix/parts/outputs/apps.nix); never executed directly.

set -Eueo pipefail

FLAKE=${1:-$(hostname -s)}

print_main_banner

# =======================================================================
# = Main functions
# =======================================================================

if ! command -v nixos-rebuild >/dev/null; then
	log_error "nixos-rebuild was not found; this bootstrap currently supports NixOS hosts only"
fi

if [ -e "$DOTFILES_DIR/flake.nix" ]; then
	FLAKE_ROOT="$DOTFILES_DIR"
elif [ -n "${BOOTSTRAP_FLAKE_ROOT:-}" ]; then
	FLAKE_ROOT="$BOOTSTRAP_FLAKE_ROOT"
else
	log_error "Could not find a flake source for bootstrap"
fi

cache_options=$(host_cache_options "nixosConfigurations.$FLAKE")
mapfile -t CACHE_OPTIONS <<<"$cache_options"

log_info "Installing flake -> $FLAKE"
sudo nixos-rebuild switch --flake "$FLAKE_ROOT#$FLAKE" --option eval-cache false "${CACHE_OPTIONS[@]}"
log_success "$FLAKE installed"

clone_dotfiles

log_success "Done."

# Keys and the pass store are set up by hand afterwards, so failures here are
# a to-do list rather than a bootstrap error.
doctor || log_info "Finish the items marked [!!] above, then rerun: nix run ~/.dotfiles#doctor"
