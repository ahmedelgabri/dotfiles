#!/usr/bin/env bash

# mx
# version 2.2

# Contributors:
#   Wynn Netherland - http://github.com/pengwynn
#   Adam Jahnke - http://github.com/adamyonk
#   Yoshua Wuyts - https://github.com/yoshuawuyts
#   Ahmed El Gabri - https://github.com/ahmedelgabri

# Usage:
#   mx                  session for $PWD (name = basename of $PWD)
#   mx <name>           session definition lookup, then project lookup by name
#   mx --dir <path>     plain session rooted exactly at <path>
#   mx --list           print session/project candidates as TSV
#   mx --pick [query]   fuzzy-pick a candidate and launch it
#   mx --export [session]
#                       print a definition based on a session
#   mx --migrate        convert the old bash definitions in
#                       {$HOST_CONFIGS,$XDG_CONFIG_HOME}/tmux/sessions
#   mx -h|--help        print usage
#
# Session definitions are Lua files looked up as
# $HOST_CONFIGS/mx/sessions/<name>.lua then
# $XDG_CONFIG_HOME/mx/sessions/<name>.lua; see README.md next to this script.
# Every new session also gets the windows from $XDG_CONFIG_HOME/mx/shared.lua.
#
# Project lookup resolves <name> against --list labels (exact match, or a
# unique /<name> suffix), so `mx git-wt` and `mx c/master` work from
# anywhere. No match falls back to a plain session at $PWD.

set -ue -o pipefail

if [[ -n "${DEBUG-}" ]]; then
	set -x
fi

usage_text() {
	echo "Usage: mx [<name>] | mx --dir <path> | mx --list | mx --pick [query] | mx --export [session] | mx --migrate"
}

usage() {
	usage_text >&2
	exit 64
}

show_help() {
	usage_text
	exit 0
}

sanitize() {
	# tmux forbids '.' and ':' in session names
	local s="${1//./_}"
	printf '%s\n' "${s//:/_}"
}

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mx"
# Written by the zsh preexec hook in extras.zsh, one file per pane
COMMANDS_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mx/commands"
# The package installs the backends next to its bin directory.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LUA_DIR="$HERE/../share/mx"

# Session definition search path; first hit wins
SESSION_DIRS=(
	"${HOST_CONFIGS:+$HOST_CONFIGS/mx/sessions}"
	"$CONFIG_DIR/sessions"
)

find_session_file() {
	local dir f
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] || continue
		f="$dir/$1.lua"
		if [ -f "$f" ]; then
			printf '%s\n' "$f"
			return 0
		fi
	done
	return 1
}

# mx --list enumerates session candidates as TSV: <kind>\t<label>\t<abspath>
#   kind    = 'sess' (session definition file) or 'dir' (project directory)
#   label   = definition name, or dir path relative to $PROJECTS
#   abspath = the definition file for 'sess', the directory for 'dir'
#
# Root rules:
#   personal|trunk|forks|ahmedelgabri : every direct subdirectory
#   work/<org>/<project>              : every project; .bare projects also
#                                       list child worktrees (subdirs with .git)
#   archive                           : project children are leaves; other
#                                       children are grouping dirs whose child
#                                       dirs are candidates
#
# Deliberately uses shell globs instead of fd: a bare fd honors the global
# ignore file (config/.ignore) and would silently hide candidates, and fd -I
# would cost an external process per depth-1 listing for no gain over the
# builtin. nullglob makes missing roots and empty dirs a no-op, and plain */
# globs skip files and dotdirs.

shopt -s nullglob

emit() {
	printf '%s\t%s\t%s\n' "$1" "$2" "$3"
}

# A git repo, a git-wt bare layout, or a (possibly non-colocated) jj repo.
is_project() {
	[ -e "$1/.git" ] || [ -e "$1/.bare" ] || [ -e "$1/.jj" ]
}

# In a .bare layout only children holding a .git entry are worktrees; the
# filter keeps scratch dirs (e.g. work/<name>/c/_) out of the candidate list.
emit_worktrees() {
	local proj="$1" label="$2" wt
	for wt in "$proj"/*/; do
		wt="${wt%/}"
		[ -e "$wt/.git" ] || continue
		emit dir "$label/${wt##*/}" "$wt"
	done
}

list_sessions() {
	local dir f name
	local -A seen=()
	# $HOST_CONFIGS wins over the repo-tracked dir
	for dir in "${SESSION_DIRS[@]}"; do
		[ -n "$dir" ] && [ -d "$dir" ] || continue
		for f in "$dir"/*.lua; do
			[ -f "$f" ] || continue
			name="${f##*/}"
			name="${name%.lua}"
			[ -n "${seen[$name]-}" ] && continue
			seen[$name]=1
			emit sess "$name" "$f"
		done
	done
}

list_flat() {
	local d
	for d in "$PROJECTS/$1"/*/; do
		d="${d%/}"
		emit dir "$1/${d##*/}" "$d"
	done
}

list_work() {
	local org org_name proj label
	for org in "$PROJECTS/work"/*/; do
		org="${org%/}"
		org_name="${org##*/}"
		for proj in "$org"/*/; do
			proj="${proj%/}"
			label="work/$org_name/${proj##*/}"
			emit dir "$label" "$proj"
			if [ -e "$proj/.bare" ]; then
				emit_worktrees "$proj" "$label"
			fi
		done
	done
}

list_archive() {
	local d label sub
	for d in "$PROJECTS/archive"/*/; do
		d="${d%/}"
		label="archive/${d##*/}"
		if is_project "$d"; then
			emit dir "$label" "$d"
			if [ -e "$d/.bare" ]; then
				emit_worktrees "$d" "$label"
			fi
		else
			for sub in "$d"/*/; do
				sub="${sub%/}"
				emit dir "$label/${sub##*/}" "$sub"
			done
		fi
	done
}

list_candidates() {
	: "${PROJECTS:?PROJECTS is not set}"
	list_sessions
	list_work
	list_flat trunk
	list_flat personal
	list_flat forks
	list_flat ahmedelgabri
	list_archive
}

resolve_dirs() {
	# all --list dir candidates whose label is $1 or ends in /$1
	list_candidates | awk -F'\t' -v n="$1" \
		'$1 == "dir" && ($2 == n || substr($2, length($2) - length(n)) == "/" n) { print $3 }'
}

derive_name() {
	local rel="${1#"${PROJECTS-}"/}"
	case "$rel" in
	work/*/*) rel="${rel#work/*/}" ;; # <project> or <project>/<worktree>
	forks/* | archive/*) ;;           # duplication is structural; keep qualified
	*) rel="${rel##*/}" ;;            # canonical homes: basename only
	esac
	printf '%s\n' "$rel"
}

# Every _shared window after its plain first one, in shared.lua order.
link_shared_windows() {
	local name="$1" window

	tmux list-windows -t "=_shared" -F '#{window_id}' | tail -n +2 |
		while read -r window; do
			tmux link-window -a -s "$window" -t "=$name:{end}"
		done
}

mx_export() {
	local session="${1-}"

	if [[ -z "$session" ]]; then
		if [[ -z ${TMUX-} ]]; then
			echo "mx: --export needs a session name outside tmux" >&2
			return 64
		fi
		session="$(tmux display-message -p '#{session_name}')"
	fi

	if ! tmux has-session -t "=$session" 2>/dev/null; then
		echo "mx: session not found: $session" >&2
		return 1
	fi

	luajit "$LUA_DIR/tmux.lua" export "$session" "$COMMANDS_DIR"
}

# Stands in for tmux while an old definition's mx_start runs: send-keys is
# how those definitions typed commands, so the keys are written where the zsh
# hook would have recorded them instead of being run.
migrate_tmux() {
	local target="" literal=0 text="" key file

	if [[ ${1-} != send-keys ]]; then
		command tmux "$@"
		return
	fi
	shift
	while (($#)); do
		case "$1" in
		-t)
			target="$2"
			shift 2
			;;
		-l)
			literal=1
			shift
			;;
		--)
			shift
			break
			;;
		-*) shift ;;
		*) break ;;
		esac
	done
	for key in "$@"; do
		if ((literal)); then
			text+="$key"
			continue
		fi
		case "$key" in
		C-m | Enter | KPEnter) ;;
		Space) text+=" " ;;
		*) text+="$key" ;;
		esac
	done
	[ -n "$text" ] || return 0
	file="$COMMANDS_DIR/tmux-$(command tmux display-message -p -t "$target" '#{pid}-#{pane_id}' | tr -d %)"
	if [ -e "$file" ]; then
		printf '\n%s' "$text" >>"$file"
	else
		printf '%s' "$text" >"$file"
	fi
}

# Prints the Lua definition for an old bash one: its mx_start runs against a
# private tmux server, and the result is exported like any session.
migrate_definition() (
	local source="$1" root
	local scratch
	scratch="$(mktemp -d)"
	# shellcheck disable=SC2064 # The path is fixed when the trap is set.
	trap "TMUX_TMPDIR='$scratch' command tmux kill-server 2>/dev/null; rm -rf '$scratch'" EXIT

	unset TMUX TMUX_PANE
	export TMUX_TMPDIR="$scratch"
	COMMANDS_DIR="$scratch/commands"
	mkdir "$COMMANDS_DIR"

	# shellcheck disable=SC1090
	source "$source"
	root="${MX_ROOT:-$HOME}"
	cd "$root"
	export MX_SESSION=migrate MX_ROOT="$root"
	# Old definitions assume the indexing of the real tmux.conf. A plain sh
	# in every pane keeps the user's shell config from typing anything.
	command tmux -f /dev/null start-server \; \
		set -g base-index 1 \; setw -g pane-base-index 1 \; \
		set -g default-shell /bin/sh \; \
		new-session -d -s migrate -c "$root"

	if declare -F mx_start >/dev/null; then
		# shellcheck disable=SC2329 # mx_start calls it.
		tmux() { migrate_tmux "$@"; }
		if ! mx_start; then
			echo "mx: mx_start in $source failed; converted what it built" >&2
		fi
		unset -f tmux
	fi
	luajit "$LUA_DIR/tmux.lua" export migrate "$COMMANDS_DIR" "$source"
)

# Converts every old definition that has no new one yet. Old files stay in
# place.
mx_migrate() {
	local from to f name target status=0
	local -a pairs=(
		"${HOST_CONFIGS:+$HOST_CONFIGS/tmux/sessions}" "${HOST_CONFIGS:+$HOST_CONFIGS/mx/sessions}"
		"${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions" "$CONFIG_DIR/sessions"
	)

	while ((${#pairs[@]})); do
		from="${pairs[0]}" to="${pairs[1]}"
		pairs=("${pairs[@]:2}")
		[ -n "$from" ] && [ -d "$from" ] || continue
		for f in "$from"/*; do
			name="${f##*/}"
			[ -f "$f" ] && [ "$name" != README.md ] || continue
			target="$to/$name.lua"
			if [ -e "$target" ]; then
				echo "mx: skipped $f: $target exists" >&2
				continue
			fi
			mkdir -p "$to"
			if migrate_definition "$f" >"$target.tmp"; then
				mv "$target.tmp" "$target"
				echo "$f -> $target"
			else
				rm -f "$target.tmp"
				echo "mx: could not convert $f" >&2
				status=1
			fi
		done
	done
	return "$status"
}

# mx --pick [query] - fuzzy-pick a project or defined session, then launch it
#   - Bypasses the finder when the query matches exactly one candidate (--select-1)
#   - Exits cleanly when there is no match or on cancel (--exit-0)
# Lines are --list TSV; fields 1-2 are shown, field 3 (abspath) rides along
# so the selection never has to be re-derived from display text.
mx_pick() {
	local line kind label path
	local fzf_opts=(
		--query="${1-}"
		--select-1
		--exit-0
		--no-multi
		--delimiter=$'\t'
		"--with-nth=1,2"
		--nth=2
		--tabstop=8
		--scheme=path
		--prompt="mx » "
		"--preview=COLORTERM=truecolor previewer {3}"
		"--preview-window=right:border-left:60%:hidden"
	)

	if [[ -n ${TMUX-} ]]; then
		fzf_opts+=("--popup=center,70%,70%" --border=none)
	else
		fzf_opts+=(--height=40%)
	fi

	line="$(list_candidates | fzf "${fzf_opts[@]}")" || return 0
	IFS=$'\t' read -r kind label path <<<"$line"

	case "$kind" in
	sess) main "$label" ;;
	dir) main --dir "$path" ;;
	esac
}

main() {
	local root="" session_file="" name="" matches=""

	case "${1-}" in
	--dir)
		[ $# -eq 2 ] || usage
		[ -d "${2-}" ] || usage
		root="$(cd "$2" && pwd)"
		name="$(derive_name "$root")"
		;;
	--list)
		[ $# -eq 1 ] || usage
		list_candidates
		exit 0
		;;
	--pick)
		[ $# -le 2 ] || usage
		mx_pick "${2-}"
		exit 0
		;;
	--export)
		[ $# -le 2 ] || usage
		mx_export "${2-}"
		exit $?
		;;
	--migrate)
		[ $# -eq 1 ] || usage
		mx_migrate
		exit $?
		;;
	-h | --help)
		[ $# -eq 1 ] || usage
		show_help
		;;
	--*)
		usage
		;;
	'')
		root="$PWD"
		name="$(basename "$PWD")"
		;;
	*)
		[ $# -eq 1 ] || usage
		name="$1"
		# A definition without `root` starts at $PWD.
		root="$PWD"
		if ! session_file="$(find_session_file "$name")"; then
			session_file=""
			matches="$(resolve_dirs "$name")"
			if [ -n "$matches" ]; then
				if [ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]; then
					echo "mx: '$name' is ambiguous:" >&2
					printf '%s\n' "$matches" | sed 's/^/  /' >&2
					exit 1
				fi
				root="$matches"
				# same session name whether typed or picked
				name="$(derive_name "$root")"
			fi
		fi
		;;
	esac

	local tmux_name
	tmux_name="$(sanitize "$name")"

	if ! tmux has-session -t "=$tmux_name" 2>/dev/null; then
		"$HERE/mx-init"
		# A definition that fails to load creates no session.
		luajit "$LUA_DIR/tmux.lua" open "$tmux_name" "$session_file" "$root"
		# Definition windows come first; shared windows are appended afterwards.
		link_shared_windows "$tmux_name"
		tmux select-window -t "=$tmux_name:^"
	fi

	if [ -z "${TMUX-}" ]; then
		exec tmux attach -t "=$tmux_name"
	else
		exec tmux switch-client -t "=$tmux_name"
	fi
}

main "$@"
