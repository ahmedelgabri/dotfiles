let
  module = {
    commonModule =
      {
        config,
        pkgs,
        ...
      }:
      {
        environment.etc."codex/config.toml".source = "${config.my.dotfilesDir}/config/codex/config.toml";

        environment.variables = {
          CLAUDE_CODE_TMPDIR = "$HOME/.claude/agent-tmp-stuff";
          CODEX_HOME = "$HOME/.config/codex";
          PI_CODING_AGENT_DIR = "$HOME/.config/pi/agent";
        };

        my.user.packages = with pkgs; [
          llm-agents.claude-code
          llm-agents.codex
          llm-agents.pi
          llm-agents.qmd
          llm-agents.agent-browser
          llama-cpp
          ccpeek
        ];
      };

    homeManager =
      {
        config,
        lib,
        pkgs,
        myConfig,
        ...
      }:

      let
        dotfilesConfig = "${myConfig.dotfilesDir}/config";
        # Types-only copies of pi's extension API, fetched from npm for tsc
        # and editors; pi resolves these imports internally at runtime. The
        # tree must not link into pi's store path: pi stopped shipping
        # unpacked node_modules, and the links went dangling on every pi
        # bump once the old store path was GC'd. The pins are generated by
        # the update-pi-extension-types command below (run by nixup).
        piAgentExtensionNodeModules = import ./pi-extension-types.nix { inherit pkgs; };
        updatePiExtensionTypes = pkgs.writeShellApplication {
          name = "update-pi-extension-types";
          runtimeInputs = with pkgs; [
            gnutar
            jq
            nix
            nodejs
            ripgrep
          ];
          # The package set follows the code: the extensions' bare imports
          # (plus tsconfig `types`) are the roots, and each package's .d.ts
          # imports pull in the rest. Versions come from whoever imports
          # the package, so pi's own pins win over npm's latest.
          text = ''
            registry="https://registry.npmjs.org"
            dotfiles="${myConfig.dotfilesDir}"
            lockfile="$dotfiles/nix/parts/modules/shared/pi-extension-types.lock.json"
            extensions="$dotfiles/config/pi/agent/extensions"

            tmp=$(mktemp -d)
            trap 'rm -rf "$tmp"' EXIT

            # The installed pi comes from the locked llm-agents input, and
            # npm's latest can run ahead of it.
            pi_version=$(nix eval --raw --inputs-from "$dotfiles" llm-agents#pi.version)
            pi_deps=$(npm view "@earendil-works/pi-coding-agent@$pi_version" dependencies --json)

            declare -A builtin=()
            while IFS= read -r module; do
              builtin[$module]=1
            done < <(node -p 'require("node:module").builtinModules.join("\n")')

            # Print the npm packages imported by the files rg selects, with
            # relative paths and Node built-ins left out. Static imports
            # only count outside comment lines, so JSDoc examples such as
            # `Buffer.from("abc")` or `import x from "foo"` don't match.
            bare_imports() {
              local spec scope rest
              {
                rg --no-filename --only-matching --replace '$1$2' "$@" \
                  -e '^\s*(?:[^\s*/][^"\x27\n]*?)?\b(?:from|import)\s*["\x27]([^"\x27./][^"\x27]*)["\x27]' \
                  -e '\bimport\(\s*["\x27]([^"\x27./][^"\x27]*)["\x27]\s*\)' ||
                  [ $? -eq 1 ]
              } | while IFS= read -r spec; do
                case $spec in
                  node:*) continue ;;
                  @*) IFS=/ read -r scope rest _ <<<"$spec" && spec="$scope/$rest" ;;
                  *) spec=''${spec%%/*} ;;
                esac
                [ -n "''${builtin[$spec]:-}" ] || printf '%s\n' "$spec"
              done | sort -u
            }

            # The .js files are browser code that loads its packages from a
            # CDN import map, and tsc doesn't check JS.
            queue=()
            while IFS= read -r name; do
              spec=$(jq -r --arg n "$name" '.[$n] // empty' <<<"$pi_deps")
              [ "$name" = "@earendil-works/pi-coding-agent" ] && spec=$pi_version
              queue+=("$name ''${spec:-latest}")
            done < <({
              bare_imports -g '*.ts' "$extensions"
              jq -r '.compilerOptions.types[]? | "@types/" + .' "$extensions/tsconfig.json"
            } | sort -u)

            # node_modules is flat, so the first version queued for a name wins.
            declare -A seen=()
            lock='{}'
            while [ ''${#queue[@]} -gt 0 ]; do
              read -r name spec <<<"''${queue[0]}"
              queue=("''${queue[@]:1}")
              [ -z "''${seen[$name]:-}" ] || continue
              seen[$name]=1

              version=$(npm view "$name@$spec" version --json | jq -r 'if type == "array" then last else . end')
              url="$registry/$name/-/''${name##*/}-$version.tgz"
              prefetch=$(nix store prefetch-file --json "$url")
              printf '%s %s\n' "$name" "$version" >&2
              lock=$(jq --arg name "$name" --arg version "$version" --argjson prefetch "$prefetch" \
                '. + {($name): {version: $version, hash: $prefetch.hash}}' <<<"$lock")

              mkdir "$tmp/unpack"
              tar -xzf "$(jq -r .storePath <<<"$prefetch")" -C "$tmp/unpack"
              manifest=$(cat "$tmp"/unpack/*/package.json)
              while IFS= read -r dep; do
                [ "$dep" != "$name" ] || continue
                spec=$(jq -r --arg n "$dep" \
                  '.dependencies[$n] // .peerDependencies[$n] // .optionalDependencies[$n] // empty' <<<"$manifest")
                if [ -z "$spec" ]; then
                  echo "warning: $name imports undeclared $dep; skipping" >&2
                  continue
                fi
                queue+=("$dep $spec")
              done < <(bare_imports -g '*.d.ts' -g '*.d.mts' -g '*.d.cts' "$tmp/unpack")
              rm -rf "$tmp/unpack"
            done

            # Replace the lockfile only after every fetch has succeeded.
            jq -S . <<<"$lock" >"$tmp/lock.json"
            mv "$tmp/lock.json" "$lockfile"
            echo "Wrote $lockfile"
          '';
        };
        mkConfigTree =
          { dir, target }:
          config.lib.file.mkOutOfStoreTree {
            source = ../../../../config + "/${dir}";
            sourceRoot = "${dotfilesConfig}/${dir}";
            targetRoot = target;
          };
        mkClaudeTree =
          { sub, target }:
          mkConfigTree {
            dir = "claude/${sub}";
            inherit target;
          };
        configHome = lib.removePrefix "${config.home.homeDirectory}/" config.xdg.configHome;
        # Pi and Codex read ~/.agents/skills on their own, so shared skills
        # only need extra links for harnesses that don't. Harness-specific
        # trees come after the shared one so they win on a path collision.
        skillTrees = [
          {
            dir = "agents/skills";
            targets = [
              ".agents/skills"
              ".claude/skills"
            ];
          }
          {
            dir = "claude/skills";
            targets = [ ".claude/skills" ];
          }
          {
            dir = "pi/skills";
            targets = [ "${configHome}/pi/agent/skills" ];
          }
          {
            dir = "codex/skills";
            targets = [ "${configHome}/codex/skills" ];
          }
        ];
        mkSkillTrees =
          { dir, targets }:
          # Git does not track empty directories, so a harness may have none.
          lib.optionals (builtins.pathExists (../../../../config + "/${dir}")) (
            map (target: mkConfigTree { inherit dir target; }) targets
          );
      in
      {
        xdg.configFile =
          config.lib.file.mkOutOfStoreTree {
            source = ../../../../config/pi/agent;
            sourceRoot = "${dotfilesConfig}/pi/agent";
            targetRoot = "pi/agent";
          }
          // {
            "codex/hooks.json".source = pkgs.replaceVars ../../../../config/codex/hooks.json {
              injectRepoInfo = "${config.home.homeDirectory}/.dotfiles/config/claude/hooks/inject-repo-info.sh";
            };
            "codex/themes/plain.tmTheme".source =
              config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/bat/themes/plain.tmTheme";

            "codex/AGENTS.md".source =
              config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/claude/CLAUDE-template.md";

            "pi/agent/settings.json".source =
              config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/pi/settings.json";

            "pi/agent/AGENTS.md".source =
              config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/claude/CLAUDE-template.md";

            "pi/agent/mcp.json".source =
              config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/pi/agent/mcp.json";
          };

        home = {
          packages = [ updatePiExtensionTypes ];

          activation = {
            linkPiAgentExtensionNodeModules = config.lib.dag.entryAfter [ "writeBoundary" ] ''
              TARGET="${myConfig.dotfilesDir}/config/pi/agent/extensions/node_modules"
              SOURCE="${piAgentExtensionNodeModules}"

              if [ -e "$TARGET" ] && [ ! -L "$TARGET" ]; then
                echo "Refusing to replace non-symlink $TARGET" >&2
                exit 1
              fi

              mkdir -p "$(dirname "$TARGET")"
              rm -f "$TARGET"
              ln -s "$SOURCE" "$TARGET"
            '';
          };

          file = lib.mergeAttrsList (
            map mkClaudeTree [
              {
                sub = "agents";
                target = ".claude/agents";
              }
              {
                sub = "docs";
                target = ".claude/docs";
              }
              {
                sub = "commands";
                target = ".claude/commands";
              }
              {
                sub = "hooks";
                target = ".claude/hooks";
              }
              {
                sub = "scripts";
                target = ".claude/scripts";
              }
            ]
            ++ lib.concatMap mkSkillTrees skillTrees
            ++ [
              {
                ".claude/CLAUDE.md".source =
                  config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/claude/CLAUDE-template.md";

                ".claude/settings.json".source =
                  config.lib.file.mkOutOfStoreSymlink "${dotfilesConfig}/claude/settings.json";
              }
            ]
          );
        };
      };

    darwin =
      { pkgs, ... }:
      {
        imports = [ module.commonModule ];
        config = {
          homebrew = {
            taps = [ "openai/tools" ];
            brews = [ "openai/tools/tart" ];
            casks = [ "claude" ];
          };
          my.user.packages = with pkgs; [
            sb
          ];
        };
      };

    nixos =
      { ... }:
      {
        imports = [ module.commonModule ];
      };
  };
in
{
  flake = {
    modules = {
      darwin.ai = module.darwin;
      nixos.ai = module.nixos;
      homeManager.ai = module.homeManager;
    };
  };
}
